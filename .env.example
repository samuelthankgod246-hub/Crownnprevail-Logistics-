# Firebase Configuration
# Copy this file to .env and fill in your Firebase project details
# DO NOT commit .env to git - it contains sensitive credentials

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# OpenRouter API (for AI Assistant feature)
# Get free API key from https://openrouter.ai/
VITE_OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
VITE_OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# Gemini API (fallback option)
# Get free API key from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
